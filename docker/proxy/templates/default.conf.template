# Point d'entrée unique en 443. Les ports applicatifs ne sont jamais publiés : c'est la
# topologie réelle de la production, éprouvée dès le développement.
#
# Ce fichier est un TEMPLATE : l'image nginx substitue ${DEV_HOST} au démarrage, à
# partir de la variable d'environnement du service. Ne pas le renommer en `.conf`,
# la substitution ne s'appliquerait plus.

# Traduit l'en-tête Upgrade en valeur de Connection. Requis pour les WebSockets.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# nginx résout les noms de ses upstreams UNE fois, au démarrage, quand ils sont écrits
# littéralement dans `proxy_pass` : si une application n'est pas encore lancée, nginx
# refuse de démarrer au lieu de l'attendre. Passer par une variable force la résolution
# à chaque requête, via le résolveur interne de Docker.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 443 ssl;
    # HTTP/2 est volontairement désactivé : son mécanisme d'upgrade diffère de celui de
    # HTTP/1.1, et nginx ne relaie pas les WebSockets vers l'amont en HTTP/2. Le
    # rechargement à chaud de Next s'en sert, et Socket.IO s'en servira. Avec `http2 on`,
    # le navigateur négocie HTTP/2, le WebSocket échoue sur « Invalid status line »,
    # l'hydratation React s'interrompt — et les formulaires se soumettent en GET natif,
    # identifiants dans l'URL.
    server_name ${DEV_HOST};

    ssl_certificate     /certs/dev.pem;
    ssl_certificate_key /certs/dev-key.pem;

    location / {
        set $cible http://storefront:3000;
        proxy_pass $cible;
        include /etc/nginx/snippets/proxy-commun.conf;
    }
}

