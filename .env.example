NODE_ENV=development

DATABASE_URL=postgresql://clemperl:clemperl@postgres:5432/clemperl
REDIS_URL=redis://redis:6379

# Adresse locale de la machine. Sert uniquement à joindre la stack depuis un autre
# appareil du réseau — un téléphone, pour vérifier la réactivité de l'interface.
DEV_HOST=10-0-10-176.sslip.io

NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_VENDOR_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3003

# Secret de signature des sessions. En développement, une valeur quelconque de plus de
# 32 caractères suffit ; en production, une valeur tirée au hasard et jamais partagée.
# Domaine parent du cookie de session. Laissé VIDE en développement : les applications
# sont sur localhost à des ports différents, où les cookies sont déjà partagés. En
# production, y mettre `.clemperl.com`.
COOKIE_DOMAIN=

BETTER_AUTH_SECRET=developpement-seulement-remplacer-par-un-secret-tire-au-hasard

SMTP_URL=smtp://mailpit:1025
# Les guillemets sont nécessaires : les chevrons sont des redirections pour le
# shell, et ce fichier est aussi lu par `source` dans les scripts.
EMAIL_FROM="ClemPerl <bonjour@clemperl.test>"

# Renseigner pour activer la connexion Google. Laisser vide sinon : le fournisseur n'est
# alors pas déclaré, et seul le parcours par mot de passe existe.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ACTIF=

# Décommenter si le rechargement à chaud ne réagit pas (repli inotify).
# WATCHPACK_POLLING=true

# Stockage des pièces justificatives des dossiers vendeurs. En développement, un
# conteneur `supabase/storage-api` sert la même API que Supabase en production : même
# SDK, mêmes routes, mêmes URL signées. Seul le serveur en face change.
#
# Ces deux valeurs ne sont PAS des secrets : elles ne valent que pour la stack locale, et
# la clé de service est un JWT signé par le secret ci-dessous, reproductible à
# l'identique sur toute machine. En production, tirer un secret au hasard et prendre la
# clé de service du projet Supabase.
STORAGE_URL=http://localhost:5010
STORAGE_BUCKET=vendor-documents
STORAGE_JWT_SECRET=developpement-seulement-secret-de-signature-du-stockage
STORAGE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoiY2xlbXBlcmwtZGV2IiwiaWF0IjoxNzUwMDAwMDAwLCJleHAiOjIyMDAwMDAwMDB9.OeDKJJu4-QwF2j54pqhZTzRwOafBNzbN02pjFDJvmP0
