# Adresses que le TÉLÉPHONE utilise pour joindre la pile de développement : celles du poste
# sur le réseau local, et non `localhost`, qui désignerait le téléphone lui-même. Copier ce
# fichier en `.env`, ignoré par Git, et y mettre l'adresse du poste.
EXPO_PUBLIC_API_URL=http://192.0.2.10:3003
EXPO_PUBLIC_STOREFRONT_URL=http://192.0.2.10:3000
